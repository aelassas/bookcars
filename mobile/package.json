{
  "name": "bookcars-mobile",
  "description": "Mobile app for BookCars (customer app)",
  "version": "9.4.0",
  "main": "expo-router/entry",
  "scripts": {
    "install:dependencies": "cd ../packages/currency-converter && npm i && cd ../bookcars-helper && npm i",
    "eas-build-pre-install": "npm run install:dependencies",
    "ts:build": "npm run install:dependencies && tsc --build --verbose",
    "ts:check": "npm run ts:build",
    "start": "npm run ts:build && expo start --port 8082",
    "start:clean": "npm run ts:build && expo start -c --port 8082",
    "android": "npm run ts:build && expo run:android",
    "ios": "npm run ts:build && expo run:ios",
    "build:android": "cross-env EAS_NO_VCS=1 npm run ts:build && eas build --profile production --platform android",
    "build:android:local": "cross-env EAS_NO_VCS=1 npm run ts:build && eas build --profile production --platform android --local",
    "build:android:preview": "cross-env EAS_NO_VCS=1 npm run ts:build && eas build --profile preview --platform android",
    "build:ios": "cross-env EAS_NO_VCS=1 npm run ts:build && eas build --profile production --platform ios",
    "build:ios:local": "cross-env EAS_NO_VCS=1 npm run ts:build && eas build --profile production --platform ios --local",
    "build:ios:preview": "cross-env EAS_NO_VCS=1 npm run ts:build && eas build --profile preview --platform android",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "fix": "eslint --fix .",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@stripe/stripe-react-native": "0.81.0",
    "@types/react-native-google-signin": "^1.0.7",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0",
    "base-64": "^1.0.0",
    "date-fns": "^4.4.0",
    "expo": "^58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "i18n-js": "^4.5.4",
    "lodash.debounce": "^4.0.8",
    "mime": "^4.1.2",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-animatable": "^1.4.0",
    "react-native-dotenv": "^5.0.0",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-feather": "^2.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "0.13.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/base-64": "^1.0.2",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mime": "^4.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "~19.3.0",
    "@types/react-native-dotenv": "^0.2.2",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
