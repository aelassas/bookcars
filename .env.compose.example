# Copy to .env and set unique secrets. Never commit the copied .env file.
# For an existing Mongo volume, values must match its initialized root account.
MONGO_ROOT_USERNAME=replace_with_a_unique_username
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGO_EXPRESS_USERNAME=replace_with_a_unique_viewer_username
MONGO_EXPRESS_PASSWORD=replace_with_a_different_long_random_password

# Must match MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD and the current replica-set host.
# URL-encode special characters in the username/password.
BC_DB_URI=mongodb://replace_with_a_unique_username:replace_with_a_long_random_password@mongo:27017/safarrent?authSource=admin&appName=safarrent&replicaSet=rs0
# Ollama model files (keep large local models on D: instead of the C: drive)
SAFARRENT_OLLAMA_MODELS_DIR=D:/bookcars/.data/ollama-models

# Local-only by default. scripts/start-lan-demo.ps1 sets these for phone testing
# on the same trusted Wi-Fi; this is not an internet production deployment.
SAFARRENT_BIND_ADDRESS=127.0.0.1
SAFARRENT_LAN_HOST=localhost
