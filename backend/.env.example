# General
NODE_ENV=development

# Backend server
BC_PORT=4002
BC_HTTPS=false
BC_PRIVATE_KEY=/etc/ssl/bookcars.key
BC_CERTIFICATE=/etc/ssl/bookcars.crt

# MongoDB
# Note: replicaSet=rs0 is required for MongoDB transactions/concurrency locks (e.g. saveBookingsWithAvailability).
# Note: Remove `&replicaSet=rs0` if running a standalone MongoDB instance without replica set support.
BC_DB_URI=mongodb://127.0.0.1:27017/safarrent?replicaSet=rs0
BC_DB_SSL=false
BC_DB_SSL_CERT=/etc/ssl/bookcars.crt
BC_DB_SSL_CA=/etc/ssl/bookcars.ca.pem
BC_DB_DEBUG=false

# Redis
BC_REDIS_URL=redis://127.0.0.1:6379

# Redis-backed per-IP token bucket; send-email has its own bucket and fails closed if Redis is unavailable.
BC_RATE_LIMIT_CAPACITY=10
BC_RATE_LIMIT_REFILL_RATE_MS=2000

# Auth
BC_COOKIE_SECRET=COOKIE_SECRET
BC_AUTH_COOKIE_DOMAIN=localhost
BC_ADMIN_HOST=http://localhost:3001/
BC_FRONTEND_HOST=http://localhost:8080/
BC_JWT_SECRET=JWT_SECRET
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400
BC_APPLE_CLIENT_ID_WEB=APPLE_CLIENT_ID_WEB
BC_APPLE_CLIENT_ID_MOBILE=APPLE_CLIENT_ID_MOBILE
BC_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
BC_GOOGLE_MOBILE_CLIENT_ID=GOOGLE_MOBILE_CLIENT_ID
BC_FACEBOOK_APP_ID=FACEBOOK_APP_ID
BC_FACEBOOK_APP_SECRET=FACEBOOK_APP_SECRET

# Currency
BC_BASE_CURRENCY=PKR

# Email (SMTP)
BC_SMTP_HOST=smtp.sendgrid.net
BC_SMTP_PORT=587
BC_SMTP_USER=apikey
BC_SMTP_PASS="PASSWORD"
BC_SMTP_FROM=no-reply@safarrent.pk
BC_CONTACT_EMAIL=info@safarrent.pk # Contact and newsletter submissions are delivered to this address.
BC_AUTO_VERIFY_ON_SIGNUP=false
BC_FYP_DEMO_MODE=false

# CDN (File storage) — native Windows local paths; use forward slashes.
# For Docker, override with /var/www/cdn paths in .env.docker.
BC_CDN_ROOT=D:/bookcars/cdn
BC_CDN_USERS=D:/bookcars/cdn/safarrent/users
BC_CDN_TEMP_USERS=D:/bookcars/cdn/safarrent/temp/users
BC_CDN_CARS=D:/bookcars/cdn/safarrent/cars
BC_CDN_TEMP_CARS=D:/bookcars/cdn/safarrent/temp/cars
BC_CDN_LOCATIONS=D:/bookcars/cdn/safarrent/locations
BC_CDN_TEMP_LOCATIONS=D:/bookcars/cdn/safarrent/temp/locations
BC_CDN_CONTRACTS=D:/bookcars/cdn/safarrent/contracts
BC_CDN_TEMP_CONTRACTS=D:/bookcars/cdn/safarrent/temp/contracts
BC_CDN_LICENSES=D:/bookcars/cdn/safarrent/licenses
BC_CDN_TEMP_LICENSES=D:/bookcars/cdn/safarrent/temp/licenses

# Localization
BC_DEFAULT_LANGUAGE=en

# Business Rules
BC_MINIMUM_AGE=21
# Require approved CNIC/KYC before checkout
BC_KYC_REQUIRED=true

# Expo
BC_EXPO_ACCESS_TOKEN=EXPO_ACCESS_TOKEN

# Stripe
BC_STRIPE_SECRET_KEY=STRIPE_SECRET_KEY
BC_STRIPE_SESSION_EXPIRE_AT=82800

# PayPal
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID
BC_PAYPAL_CLIENT_SECRET=PAYPAL_CLIENT_SECRET

# Admin
BC_ADMIN_EMAIL=admin@safarrent.pk
# Required only for one-time `npm run setup`; choose a unique password (12+ characters).
BC_ADMIN_PASSWORD=

# Google reCAPTCHA
# Required in production; leave unset in development to disable server-side verification.
BC_RECAPTCHA_SECRET=
BC_RECAPTCHA_MIN_SCORE=0.5

# Misc
BC_WEBSITE_NAME=SafarRent
BC_TIMEZONE=Asia/Karachi # Timezone for converting dates from UTC to local time (used in emails sent from backend).

# IPInfo (Geo lookup)
BC_IPINFO_API_KEY=IPINFO_API_KEY # Required for more than 1000 requests/day
BC_IPINFO_DEFAULT_COUNTRY=PK

# Language cleanup job
BC_BATCH_SIZE=1000 # Number of documents to process per batch when deleting obsolete language values

# Ollama trip assistant
BC_AI_PROVIDER=mock # mock or ollama
BC_OLLAMA_URL=http://127.0.0.1:11434
BC_OLLAMA_MODEL=llama3.1

# Sentry (Error monitoring & performance tracing)
BC_ENABLE_SENTRY=false # Set to true to enable Sentry
BC_SENTRY_DSN_BACKEND=https://your_dsn@o0.ingest.sentry.io/your_project_id # Your backend DSN (keep it secret)
BC_SENTRY_TRACES_SAMPLE_RATE=1.0 # Tracing sample rate: 1.0 = 100%, 0.1 = 10%, 0 = disabled

# AI booking intake (the API key stays on the backend)
BC_AI_PROVIDER=ollama
BC_OLLAMA_BASE_URL=http://127.0.0.1:11434
BC_OLLAMA_MODEL=qwen3:0.6b
BC_OLLAMA_TIMEOUT_MS=30000
# Optional cloud fallback/provider for environments with an OpenAI project key.
BC_OPENAI_API_KEY=
BC_OPENAI_MODEL=gpt-4o-mini
BC_ENABLE_FYP_DEMO=false
