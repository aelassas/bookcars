{
  "name": "bookcars-backend",
  "description": "Backend server for BookCars",
  "version": "9.1.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:packages": "cd ../packages/bookcars-types && npm i && npm run build && cd ../currency-converter && npm i && npm run build && cd ../bookcars-helper && npm i && npm run build && cd ../../backend",
    "dev": "npm run build:packages && nodemon",
    "dev:setup": "npm run setup && nodemon",
    "build": "npm run build:packages && cross-env NODE_OPTIONS=\"--max-old-space-size=1024\" tsc --build --verbose && babel dist -d dist",
    "start": "npm run build && node --import ./dist/src/monitoring/instrument.js dist/src",
    "start:setup": "npm run build && node dist/src/setup/setup.js && node --import ./dist/src/monitoring/instrument.js dist/src",
    "setup": "npm run build && node dist/src/setup/setup.js",
    "reset": "npm run build && node dist/src/setup/reset.js",
    "test": "npm run build:packages && rimraf coverage && npm run build && cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage --no-cache --forceExit",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "ncu": "ncu -u -x eslint",
    "script:db": "npm run build && node dist/scripts/db.js",
    "seed:dev": "npm run build && node dist/scripts/seed-dev.js",
    "clean:dev": "npm run build && node dist/scripts/clean-dev.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "escape-string-regexp": "^5.0.0",
    "expo-server-sdk": "^8.0.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "i18n-js": "^4.5.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "nocache": "^4.0.0",
    "nodemailer": "^10.3.1",
    "stripe": "^23.1.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "^30.5.2",
    "babel-plugin-add-import-extension": "^1.6.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
